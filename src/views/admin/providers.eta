<% layout('./layout') %>
<div class="page-head">
  <h1>Провайдеры</h1>
  <div class="page-actions">
    <button id="btn-prov-reload" type="button" class="btn">Обновить</button>
    <button id="btn-prov-add" type="button" class="btn btn-primary">Добавить провайдера</button>
  </div>
</div>
<p class="muted">OpenAI-совместимые апстримы для агентского контура. Ключи и значения заголовков сервер не возвращает — видны только отпечаток ключа и имена заголовков.</p>
<div id="prov-error" class="form-error hidden" role="alert"></div>
<div class="table-wrap">
  <table class="grid">
    <thead>
      <tr>
        <th>Название</th><th>Base URL</th><th>Ключ</th><th>Доп. заголовки</th><th>Учёт usage</th>
        <th class="num">Одновременных</th><th>Статус</th><th class="num">Активных ключей</th><th></th>
      </tr>
    </thead>
    <tbody id="prov-tbody">
      <tr><td colspan="9" class="muted">Загрузка…</td></tr>
    </tbody>
  </table>
</div>

<dialog id="dlg-prices" class="dlg-wide" aria-labelledby="dlg-prices-title">
  <form id="form-price" novalidate>
    <h2 id="dlg-prices-title">Цены моделей</h2>
    <div class="form-error hidden" role="alert"></div>
    <p class="muted">Провайдер не сообщает стоимость в ответе — прокси считает её по токенам и этим ценам (колонка «≈ Оценка $» в статистике). Цены — USD за 1 млн токенов. Модель — как в поле «Модель» у настроек или ключа. Для провайдера с адресом api.deepseek.com прайс DeepSeek заполняется автоматически.</p>
    <div class="table-wrap">
      <table class="grid">
        <thead>
          <tr><th>Модель</th><th class="num">Вход</th><th class="num">Из кэша</th><th class="num">Выход</th><th>Вне пика: вход / кэш / выход</th><th>Пиковые часы, UTC</th><th>Действует с</th><th></th></tr>
        </thead>
        <tbody id="prices-tbody"><tr><td colspan="8" class="muted">Загрузка…</td></tr></tbody>
      </table>
    </div>
    <div class="form-grid">
      <div class="form-row form-row-wide">
        <label for="price-model">Модель</label>
        <input id="price-model" name="model" type="text" class="mono" maxlength="200" autocomplete="off" spellcheck="false" placeholder="например, deepseek-flash" list="price-models">
        <datalist id="price-models"></datalist>
        <small class="hint">Имя должно совпадать с моделью в настройках или ключе буква в букву — подсказки ниже поля берутся из запросов этого провайдера.</small>
      </div>
      <div class="form-row">
        <label for="price-input">Вход, $ за 1 млн</label>
        <input id="price-input" name="price.input" type="text" inputmode="decimal" class="mono" autocomplete="off">
      </div>
      <div class="form-row">
        <label for="price-cacheRead">Вход из кэша, $ за 1 млн</label>
        <input id="price-cacheRead" name="price.cacheRead" type="text" inputmode="decimal" class="mono" autocomplete="off">
        <small class="hint">Пусто — по цене входа.</small>
      </div>
      <div class="form-row">
        <label for="price-output">Выход, $ за 1 млн</label>
        <input id="price-output" name="price.output" type="text" inputmode="decimal" class="mono" autocomplete="off">
      </div>
      <div class="form-row form-row-wide form-row-check">
        <label class="check"><input type="checkbox" name="hasOffPeak"> Цена зависит от времени суток (пик и вне пика)</label>
        <small class="hint" id="price-offpeak-hint">Включите, если провайдер берёт разную цену в разное время. Например, у DeepSeek пик — 01–04 и 06–10 UTC по будням, в остальное время всё вдвое дешевле. Каждый запрос считается по тарифу, действовавшему в момент его начала.</small>
      </div>
      <div class="form-row offpeak-only hidden">
        <label for="price-op-input">Вне пика: вход</label>
        <input id="price-op-input" name="price.offPeak.input" type="text" inputmode="decimal" class="mono" autocomplete="off">
      </div>
      <div class="form-row offpeak-only hidden">
        <label for="price-op-cacheRead">Вне пика: из кэша</label>
        <input id="price-op-cacheRead" name="price.offPeak.cacheRead" type="text" inputmode="decimal" class="mono" autocomplete="off">
      </div>
      <div class="form-row offpeak-only hidden">
        <label for="price-op-output">Вне пика: выход</label>
        <input id="price-op-output" name="price.offPeak.output" type="text" inputmode="decimal" class="mono" autocomplete="off">
      </div>
      <div class="form-row offpeak-only hidden">
        <label for="price-peakHours">Пиковые часы, UTC</label>
        <input id="price-peakHours" name="price.peakHoursUtc" type="text" class="mono" autocomplete="off" placeholder="01-04, 06-10">
        <small class="hint">Диапазоны часов через запятую, конец не включается.</small>
      </div>
      <div class="form-row form-row-check offpeak-only hidden">
        <label class="check"><input type="checkbox" name="price.peakWeekdaysOnly"> Пик только в будни (пн–пт)</label>
      </div>
      <div class="form-row">
        <label for="price-effectiveFrom">Действует с</label>
        <input id="price-effectiveFrom" name="effectiveFrom" type="datetime-local">
        <small class="hint">Пусто — для всех запросов, включая уже выполненные (они пересчитаются).</small>
      </div>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close>Закрыть</button>
      <button type="submit" class="btn btn-primary">Сохранить цену</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-prov" class="dlg-wide" aria-labelledby="dlg-prov-title">
  <form id="form-prov" novalidate>
    <h2 id="dlg-prov-title">Провайдер</h2>
    <div class="form-error hidden" role="alert"></div>
    <div class="form-grid">
      <div class="form-row">
        <label for="prov-name">Название</label>
        <input id="prov-name" name="name" type="text" required maxlength="100" autocomplete="off">
      </div>
      <div class="form-row">
        <label for="prov-baseUrl">Base URL</label>
        <input id="prov-baseUrl" name="baseUrl" type="url" class="mono" required maxlength="500" autocomplete="off" spellcheck="false" placeholder="https://example.com/api/v1">
      </div>
      <div class="form-row form-row-wide">
        <label for="prov-apiKey">API-ключ</label>
        <input id="prov-apiKey" name="apiKey" type="password" class="mono" autocomplete="new-password" spellcheck="false">
        <small class="hint" id="prov-apiKey-hint">Необязательно.</small>
      </div>
      <div class="form-row form-row-check hidden" id="prov-removeKey-row">
        <label class="check"><input type="checkbox" name="removeApiKey"> Удалить ключ</label>
      </div>
      <div class="form-row form-row-wide">
        <label for="prov-extraHeaders">Дополнительные заголовки (по одному в строке, «Имя: значение»)</label>
        <textarea id="prov-extraHeaders" name="extraHeaders" rows="3" class="mono" spellcheck="false" placeholder="X-Title: proxy_llm"></textarea>
        <small class="hint" id="prov-extraHeaders-hint"></small>
      </div>
      <div class="form-row form-row-check hidden" id="prov-clearHeaders-row">
        <label class="check"><input type="checkbox" name="clearHeaders"> Удалить все дополнительные заголовки</label>
      </div>
      <div class="form-row">
        <label for="prov-usageMode">Учёт usage</label>
        <select id="prov-usageMode" name="usageMode">
          <option value="auto">auto — определить автоматически</option>
          <option value="openrouter">openrouter — usage: {include: true}</option>
          <option value="stream_options">stream_options — include_usage</option>
          <option value="none">none — не запрашивать</option>
        </select>
      </div>
      <div class="form-row">
        <label for="prov-maxConcurrency">Одновременных запросов</label>
        <input id="prov-maxConcurrency" name="maxConcurrency" type="number" min="1" step="1" inputmode="numeric" placeholder="без лимита">
      </div>
      <div class="form-row edit-only form-row-check">
        <label class="check"><input type="checkbox" name="enabled"> Провайдер включён</label>
      </div>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close>Отмена</button>
      <button type="submit" class="btn btn-primary">Сохранить</button>
    </div>
  </form>
</dialog>
