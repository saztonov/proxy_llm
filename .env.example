# =========================================================================
# proxy_llm — пример конфигурации.
# Скопировать в /etc/proxy_llm/.env (chown root:proxy_llm, chmod 640).
# Все секреты ОБЯЗАТЕЛЬНО заменить перед запуском.
# =========================================================================

# === Inbound ===
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3000
# Legacy-токен клиента passdesk. При первом старте импортируется в БД как обычный токен и
# дальше управляется из админки (/admin); после импорта переменную можно удалить.
PROXY_INBOUND_TOKEN=replace-with-openssl-rand-hex-32
BODY_LIMIT_BYTES=27262976

# === OpenRouter ===
OPENROUTER_API_KEY=sk-or-v1-replace-with-real-key
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_MODEL=google/gemini-2.5-flash
# Comma-separated; пусто = одиночная model в payload, иначе массив models.
# Применяется, только когда модель не выбрана явно (клиент не прислал model, прислал
# заглушку proxy/default/auto, либо его allowedModels пуст). Явный выбор модели клиентом
# fallback-цепочку отключает.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_HTTP_REFERER=https://passdesk.your-domain.example
OPENROUTER_X_TITLE=PassDesk OCR via proxy_llm

# === Deadlines / Retry ===
# 27B VLM (id.su10) может отвечать минутами; клиент id: LLM_TIMEOUT_MS=450000.
REQUEST_DEADLINE_MS=420000
UPSTREAM_ATTEMPT_TIMEOUT_MS=360000
UPSTREAM_MAX_ATTEMPTS=2
MIN_REMAINING_MS=10000
UPSTREAM_RESPONSE_BODY_LIMIT_BYTES=2097152

# === Queue / Dedup ===
# QUEUE_CONCURRENCY — общий потолок одновременных upstream-вызовов (global).
# QUEUE_MAX_PENDING — общий потолок admitted-запросов (память/back-pressure).
# Multi-tenant рекомендуемый старт: QUEUE_CONCURRENCY=3, QUEUE_MAX_PENDING=6.
QUEUE_CONCURRENCY=1
QUEUE_MAX_PENDING=10
MAX_ACTIVE_DEDUP_KEYS=1000
GRACEFUL_DRAIN_MS=60000

# === Multi-tenant (реестр клиентов) ===
# CLIENTS_CONFIG_PATH НЕ задан → single-tenant legacy из PROXY_INBOUND_TOKEN (текущее поведение).
# Задан явно, но файл отсутствует/битый → fail-fast (сервис не стартует).
# Пример файла — deploy/clients.example.json.
# CLIENTS_CONFIG_PATH=/etc/proxy_llm/clients.json
CLIENT_DEFAULT_MAX_CONCURRENCY=1
CLIENT_DEFAULT_MAX_PENDING=10
# CSV белого списка моделей для клиентов БЕЗ явного allowedModels в clients.json:
#   пусто  = клиент НЕ выбирает модель (форс defaultModel) — безопасный дефолт, как раньше;
#   список = клиент может прислать model из него, иначе 400 model_not_allowed;
#   *      = любая модель OpenRouter (снимает контроль над роутингом и биллингом).
# Заглушки proxy/default/auto в поле model всегда означают «модель не выбираю» → defaultModel.
#
# ВНИМАНИЕ: `*` ОЖИВЛЯЕТ поле model у клиентов, которые уже шлют реальное имя модели
# (PassDesk шлёт OCR_OPENROUTER_MODEL): их роутинг и биллинг молча изменятся, а fallback-цепочка
# отключится. Включать по чек-листу docs/vps-update.md §4a: сначала точечно тем, кто доработан,
# глобальный `*` — последним шагом. Удержать клиента на старом поведении можно только явным
# "allowedModels": [] в его записи clients.json — он перебивает этот дефолт.
CLIENT_DEFAULT_ALLOWED_MODELS=

# === Storage ===
DB_PATH=/var/lib/proxy_llm/prod.db

# === Secrets (ОБЯЗАТЕЛЬНО) ===
# Шифрует API-ключи провайдеров и сайтов в SQLite (AES-256-GCM). Генерация: openssl rand -hex 32
# Ключ без БД бесполезен, БД без ключа не расшифровать: бэкапить оба, храня раздельно.
# Смена ключа — только через `npm run admin -- rekey` (перешифровывает значения в БД).
SECRETS_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# === Billing (учёт расходов) ===
# Все параметры имеют дефолты — этот блок можно не добавлять в существующий .env.
#
# IANA-зона, в которой считаются биллинговые сутки. Вычисляется при записи и хранится
# колонкой billing_day. ВАЖНО: OpenRouter отчитывается по UTC, поэтому суточные суммы
# с инвойсом не совпадут — это ожидаемо, а не ошибка.
BILLING_TIMEZONE=Europe/Moscow
# Суточная синхронизация каталога цен (GET /api/v1/models). Выключать только для отладки:
# без неё перестанет обновляться история цен, факт (usage.cost) при этом продолжит писаться.
BILLING_PRICE_SYNC_ENABLED=true
# Час (в BILLING_TIMEZONE), начиная с которого допустима синхронизация: после ночного
# бэкапа (03:00) и до дайджеста (09:00). Если снимка за сегодня нет — сервис догонит его
# сам после рестарта или простоя.
BILLING_PRICE_SYNC_HOUR=6
BILLING_PRICE_SYNC_TIMEOUT_MS=20000
# Каталог моделей — 1-3 МБ; общего UPSTREAM_RESPONSE_BODY_LIMIT_BYTES (2 МБ) ему мало.
BILLING_PRICE_BODY_LIMIT_BYTES=8388608

# === Dashboard ===
DASHBOARD_USER=admin
DASHBOARD_BASIC_AUTH_PASS=replace-with-strong-password

# === Admin site (/admin) ===
# ОБЯЗАТЕЛЬНО. Из него выводятся ключи подписи JWT и CSRF. Генерация: openssl rand -hex 32
# Смена секрета разлогинивает всех (access перестаёт проверяться), refresh-сессии в БД живут.
ADMIN_JWT_SECRET=replace-with-openssl-rand-hex-32
# Secure-флаг cookie; по умолчанию включён при NODE_ENV=production.
# ADMIN_COOKIE_SECURE=true
# ADMIN_ACCESS_TTL_SEC=900
# ADMIN_REFRESH_TTL_SEC=1209600
# ADMIN_SESSION_ABSOLUTE_TTL_SEC=2592000
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_WINDOW_SEC=900
# ADMIN_LOGIN_IP_MAX=10
# Разрешить провайдеров по http:// на loopback/частных адресах (локальная Ollama).
# ADMIN_ALLOW_INSECURE_PROVIDERS=false

# === Agent contour (/agent/v1) ===
# Рассчитано на несколько десятков одновременных пользователей агентов.
# CONCURRENCY — одновременных стримов к провайдерам; MAX_PENDING — всего принятых запросов.
# AGENT_QUEUE_CONCURRENCY=32
# AGENT_QUEUE_MAX_PENDING=64
# Дефолтные лимиты одного сотрудника/отдела (переопределяются в справочнике).
# AGENT_PRINCIPAL_MAX_CONCURRENCY=3
# AGENT_PRINCIPAL_MAX_PENDING=3
# AGENT_RATE_LIMIT_MAX=240
# AGENT_RATE_LIMIT_WINDOW_MS=60000
# AGENT_REQUEST_DEADLINE_MS=600000
# AGENT_UPSTREAM_ATTEMPT_TIMEOUT_MS=300000
# AGENT_UPSTREAM_HEADERS_TIMEOUT_MS=60000
# AGENT_STREAM_FIRST_EVENT_TIMEOUT_MS=180000
# AGENT_STREAM_IDLE_TIMEOUT_MS=120000
# Входящее тело агента (контекст Cursor обычно 50-300 КБ); nginx client_max_body_size должен совпадать.
# AGENT_BODY_LIMIT_BYTES=1048576
# AGENT_CORS_ALLOWED_ORIGINS=

# === Memory budget ===
# Оценка: QUEUE_MAX_PENDING×BODY_LIMIT_BYTES + AGENT_QUEUE_MAX_PENDING×AGENT_BODY_LIMIT_BYTES×2 + 64 МиБ.
# Держать ниже MemoryMax юнита с запасом на сам Node (~150 МиБ). warn — предупреждение в лог, fail — не стартовать.
# MEMORY_BUDGET_BYTES=419430400
# MEMORY_BUDGET_MODE=warn

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# === Alerts thresholds ===
ALERT_ERROR_STREAK_THRESHOLD=5
ALERT_ERROR_RATE_THRESHOLD=0.30
ALERT_ERROR_RATE_WINDOW=50
# 27B VLM (id.su10) часто >150s; ниже UPSTREAM_ATTEMPT_TIMEOUT_MS.
ALERT_LONG_REQUEST_MS=360000
ALERT_DISK_FREE_MIN_BYTES=524288000

# === Logging ===
LOG_LEVEL=info
NODE_ENV=production
